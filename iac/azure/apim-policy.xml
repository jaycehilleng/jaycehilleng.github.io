<!--
  Azure API Management Inbound Policy: Zero-Trust MCP Inspection Routing
  1. Validates the agent's Entra-issued token at the gateway (issuer, audience, signature, expiry).
  2. Sends the JSON-RPC payload and the caller's token out-of-band to SecureMCPProxy for inspection.
  3. Forwards to the tool backend only when inspection returns HTTP 200.

  Contract: the inspection endpoint must return 200 to allow and 403 to block.
  Status: this policy is implemented; the proxy's HTTP endpoint (/v1/mcp/inspect, FastAPI wrapper
  around SecureMCPProxy) is designed and on the roadmap. Named values {{tenant-id}}, {{mcp-audience}},
  and {{mcp-proxy-endpoint}} are set per environment.
-->
<policies>
    <inbound>
        <base />
        <!-- 1. Validate incoming JSON-RPC structural headers -->
        <check-header name="Content-Type" failed-check-httpcode="400" failed-check-error-message="Invalid Content-Type. Expected application/json" ignore-case="true">
            <value>application/json</value>
        </check-header>

        <!-- 2. Gateway token validation (Entra ID) -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized: missing or invalid agent token." require-expiration-time="true" require-signed-tokens="true">
            <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>{{mcp-audience}}</audience>
            </audiences>
        </validate-jwt>

        <!-- 3. Send payload and caller token for out-of-band security inspection -->
        <send-request mode="new" response-variable-name="inspectionResult" timeout="10" ignore-error="false">
            <set-url>https://{{mcp-proxy-endpoint}}/v1/mcp/inspect</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-header name="Authorization" exists-action="override">
                <value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
            </set-header>
            <set-body>@(context.Request.Body.As<string>(preserveBody: true))</set-body>
        </send-request>

        <!-- 4. Enforce the inspection decision: anything other than 200 is blocked (fail closed) -->
        <choose>
            <when condition="@(((IResponse)context.Variables["inspectionResult"]).StatusCode != 200)">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{
                        "jsonrpc": "2.0",
                        "error": {
                            "code": -32600,
                            "message": "Security Policy Violation: Untrusted payload rejected by Zero-Trust Inspection Proxy."
                        },
                        "id": null
                    }</set-body>
                </return-response>
            </when>
        </choose>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>