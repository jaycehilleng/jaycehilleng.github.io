// KQL detection and audit queries for the Zero-Trust MCP Gateway.
// Fields match what SecureMCPProxy._emit_telemetry emits today:
// timestamp, event_type, status, tool_name, caller_id, latency_ms, details
// Table: MCP_SecurityEvent_CL (custom table populated via a data collection rule; see docs/audit-observability.md)

// Query 1: Argument-injection blocks (alert when > 0 in 5 minutes)
MCP_SecurityEvent_CL
| where TimeGenerated >= ago(24h)
| where status == "BLOCKED" and details has "Dangerous parameter pattern"
| project TimeGenerated, caller_id, tool_name, details
| order by TimeGenerated desc

// Query 2: Token validation failures by agent, hourly (expired, forged, missing cnf, missing scope)
MCP_SecurityEvent_CL
| where TimeGenerated >= ago(24h)
| where status == "BLOCKED" and details startswith "Token validation failed"
| summarize FailureCount = count(), UniqueAgents = dcount(caller_id) by bin(TimeGenerated, 1h)
| render timechart

// Query 3: Daily gateway audit summary
MCP_SecurityEvent_CL
| where TimeGenerated >= ago(7d)
| summarize
    TotalDecisions = count(),
    Allowed = countif(status == "ALLOWED"),
    Blocked = countif(status == "BLOCKED"),
    TokenFailures = countif(details startswith "Token validation failed"),
    InjectionBlocks = countif(details has "Dangerous parameter pattern"),
    P95LatencyMs = percentile(latency_ms, 95)
    by bin(TimeGenerated, 1d)
| extend BlockRatePct = iff(TotalDecisions == 0, 0.0, round(todouble(Blocked) / TotalDecisions * 100, 2))
| order by TimeGenerated desc
